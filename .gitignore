# 不追踪 SSH 密钥和敏感信息
.ssh/
*.secret
*.key
*.pem

# 不追踪历史文件
.zsh_history
.bash_history
.mysql_history

# 不追踪缓存
.cache/
*.zwc
.zcompdump*

# Claude 认证信息与会话数据（含 worktrees、jobs、session token 等）
.claude.json
.claude/

# 编辑器日志
*.log

# 系统文件
.DS_Store
Thumbs.db

# 编辑器/工具产物
.nvimlog
.codex
*.bak
*.bak.codex-*
*.bak-*

# 工具产生的备份（DMS 升级会把 config.kdl 备份成 config.kdl.backup<epoch>）
*.backup
*.backup-*
*.backup[0-9]*

# DMS 自动生成的 niri 配置：由 DMS 重写，纳入版本控制只会产生噪音 diff。
# 真实偏好存在 DMS 的 settings.json / session.json 里，换机时 DMS 会自行重建。
# binds.kdl 例外——保留 DMS 基础快捷键与本机 DMS 映射；个人快捷键移至 shorin-niri/binds.kdl。
arch/config/niri/dms/*.kdl
!arch/config/niri/dms/binds.kdl

# matugen 生成的 kitty 配色（随主题重算）
arch/config/kitty/dank-*.conf
