// DMS 功能快捷键，由 DMS include 管理；个人快捷键见 shorin-niri/binds.kdl

binds {
    // === DMS 特有组件 ===
    // 任务管理器 (Mod+M)
    Mod+M hotkey-overlay-title="任务管理器" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    // 电源菜单 (Mod+P)
    Mod+P hotkey-overlay-title="电源菜单" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    // 定时关机菜单 (Mod+Ctrl+P)
    Mod+Ctrl+P hotkey-overlay-title="定时关机" { spawn "dank-shutdown"; }
    // 剪贴板
    Mod+Alt+V hotkey-overlay-title="剪贴板" {spawn "dms" "ipc" "call" "clipboard" "toggle";}
    Mod+Semicolon hotkey-overlay-title="剪贴板" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    // 记事本
    Mod+Shift+N hotkey-overlay-title="记事本" { spawn "dms" "ipc" "call" "notepad" "toggle"; }
    // 锁屏
    Mod+Alt+L hotkey-overlay-title="锁屏" { spawn "dms" "ipc" "call" "lock" "lock"; }
    // 锁屏、关闭显示器、休眠
    Mod+Alt+P hotkey-overlay-title="挂起" { spawn-sh "niri msg action power-off-monitors && dms ipc call lock lock && systemctl suspend";}
    // Ctrl+Alt+Del 呼出任务管理器
    Ctrl+Alt+Delete hotkey-overlay-title="任务管理器" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    // 创建窗口规则 (Mod+Shift+W)
    Mod+Shift+W hotkey-overlay-title="新建窗口规则" { spawn "dms" "ipc" "call" "window-rules" "toggle"; }

    // === 媒体控制 ===
    XF86AudioRaiseVolume hotkey-overlay-title="音量 +" allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume hotkey-overlay-title="音量 -" allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute hotkey-overlay-title="静音" allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute hotkey-overlay-title="麦克风静音" allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "micmute"; }
    XF86AudioPause hotkey-overlay-title="播放/暂停" allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPlay hotkey-overlay-title="播放/暂停" allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev hotkey-overlay-title="上一首" allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioNext hotkey-overlay-title="下一首" allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }
    Ctrl+XF86AudioRaiseVolume hotkey-overlay-title="播放器音量 +" allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "increment" "3"; }
    Ctrl+XF86AudioLowerVolume hotkey-overlay-title="播放器音量 -" allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "decrement" "3"; }

    // === 亮度控制 ===
    XF86MonBrightnessUp hotkey-overlay-title="亮度 +" allow-when-locked=true { spawn "dank-brightness" "up"; }
    XF86MonBrightnessDown hotkey-overlay-title="亮度 -" allow-when-locked=true { spawn "dank-brightness" "down"; }

    // === 工作区导航补充 (无冲突项) ===
    Mod+I hotkey-overlay-title="下一个工作区" { focus-workspace-down; }
    Mod+U hotkey-overlay-title="上一个工作区" { focus-workspace-up; }
    
    Mod+Ctrl+U hotkey-overlay-title="列移到上个工作区" { move-column-to-workspace-up; }
    Mod+Ctrl+I hotkey-overlay-title="列移到下个工作区" { move-column-to-workspace-down; }
    
    Mod+Shift+U hotkey-overlay-title="工作区上移" { move-workspace-up; }
    Mod+Shift+I hotkey-overlay-title="工作区下移" { move-workspace-down; }

    // 重命名工作区
    Mod+Alt+R hotkey-overlay-title="重命名工作区" { spawn "dms" "ipc" "call" "workspace-rename" "open"; }

    // === 数字工作区 (1-9) ===
    Mod+1 hotkey-overlay-title="切到工作区 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="切到工作区 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="切到工作区 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="切到工作区 4" { focus-workspace 4; }
    Mod+5 hotkey-overlay-title="切到工作区 5" { focus-workspace 5; }
    Mod+6 hotkey-overlay-title="切到工作区 6" { focus-workspace 6; }
    Mod+7 hotkey-overlay-title="切到工作区 7" { focus-workspace 7; }
    Mod+8 hotkey-overlay-title="切到工作区 8" { focus-workspace 8; }
    Mod+9 hotkey-overlay-title="切到工作区 9" { focus-workspace 9; }

    Mod+Ctrl+1 hotkey-overlay-title="列移到工作区 1" { move-column-to-workspace 1; }
    Mod+Ctrl+2 hotkey-overlay-title="列移到工作区 2" { move-column-to-workspace 2; }
    Mod+Ctrl+3 hotkey-overlay-title="列移到工作区 3" { move-column-to-workspace 3; }
    Mod+Ctrl+4 hotkey-overlay-title="列移到工作区 4" { move-column-to-workspace 4; }
    Mod+Ctrl+5 hotkey-overlay-title="列移到工作区 5" { move-column-to-workspace 5; }
    Mod+Ctrl+6 hotkey-overlay-title="列移到工作区 6" { move-column-to-workspace 6; }
    Mod+Ctrl+7 hotkey-overlay-title="列移到工作区 7" { move-column-to-workspace 7; }
    Mod+Ctrl+8 hotkey-overlay-title="列移到工作区 8" { move-column-to-workspace 8; }
    Mod+Ctrl+9 hotkey-overlay-title="列移到工作区 9" { move-column-to-workspace 9; }

    // === 其他备用快捷键 ===
    // 备用截图键
    XF86Launch1 hotkey-overlay-title="截图（选区）" { screenshot; }
    Ctrl+XF86Launch1 hotkey-overlay-title="截整屏" { screenshot-screen; }
    Alt+XF86Launch1 hotkey-overlay-title="截当前窗口" { screenshot-window; }
    
    // 关闭显示器备用
    Mod+Shift+P hotkey-overlay-title="关闭显示器" { power-off-monitors; }
}
