// Shorin / 用户自定义快捷键；DMS 功能快捷键见 dms/binds.kdl

binds {
    // =========================================================
    // 第一部分：Shorin 核心快捷键配置
    // =========================================================

    // 显示快捷键教程
    Mod+Shift+Slash hotkey-overlay-title="快捷键速查" { spawn "niri-keys"; }
    // niri 原生快捷键总览（备用）
    Mod+Ctrl+Slash hotkey-overlay-title="niri 原生快捷键总览" { show-hotkey-overlay; }

    // 开关输入法
    Mod+F1 hotkey-overlay-title="开关输入法" {spawn-sh "fcitx5-remote --check && fcitx5-remote -t || fcitx5 -d";}
    // disabled by Codex 2026-06-29: voxtype off
    // Ctrl+Control_R hotkey-overlay-title="语音输入 Voice Input" {spawn "bash" "-c" "~/.local/bin/voxtype-toggle.sh";}
    // 2026-09-27 重新启用 voxtype（按一下开始/再按一下结束），改用 Super+Space 系列
    Mod+Space hotkey-overlay-title="语音输入（润色）" {spawn "bash" "-c" "~/.local/bin/voxtype-toggle.sh";}
    Mod+Shift+Space hotkey-overlay-title="语音输入（原样）" {spawn "bash" "-c" "~/.local/bin/voxtype-toggle.sh --profile raw";}
    Mod+Alt+Space hotkey-overlay-title="取消语音输入" {spawn "voxtype" "record" "cancel";}
    Mod+F5 hotkey-overlay-title="快速存档" {spawn "quicksave";}
    Mod+F8 hotkey-overlay-title="快速读档" {spawn "quickload";}

    // 临时开一个浮动终端
    Mod+Slash hotkey-overlay-title="临时终端" {spawn "kitty" "--single-instance" "--class" "quickterminal";}
    //打开浏览器
    Mod+B hotkey-overlay-title="浏览器" { spawn-sh "gtk-launch \"$(xdg-settings get default-web-browser)\""; }

    // Suggested binds for running programs: terminal, app launcher, screen locker.
    Mod+T hotkey-overlay-title="终端" { spawn "kitty" "--single-instance"; }
    // settings
    Mod+F2 hotkey-overlay-title="DMS 设置" { spawn-sh "dms ipc call settings focusOrToggle";}
    Mod+F3 hotkey-overlay-title="录屏" { spawn "~/.local/bin/wf-recorder-menu";}
    // 文档管理器：统一使用 Thunar，适配 niri/GTK 会话
    Mod+E hotkey-overlay-title="文件管理器" { spawn "thunar"; }
    // Thunar 新窗口入口
    Mod+Alt+E hotkey-overlay-title="新开文件管理器窗口" { spawn "thunar" "--window"; }
    Mod+Z hotkey-overlay-title="启动器" { spawn-sh "dms ipc call spotlight toggle || fuzzel"; }
    // dms 壁纸选择
    Mod+Alt+W hotkey-overlay-title="换壁纸" { spawn "dms" "ipc" "call" "dankdash" "wallpaper";}
    // 随机下载壁纸
    Mod+Shift+F10 hotkey-overlay-title="随机下载壁纸" { spawn "~/.local/bin/random-anime-wallpaper-dms";}

    Mod+G hotkey-overlay-title="总览" repeat=false { toggle-overview; }
    // 关闭聚焦窗口
    Mod+C hotkey-overlay-title="关闭窗口" repeat=false { close-window; }
    Alt+F4 hotkey-overlay-title="关闭窗口" repeat=false { close-window; }

    // mod+鼠标中键 关闭窗口
    Mod+MouseMiddle hotkey-overlay-title="关闭窗口" { close-window; }

    // 切换聚焦
    // super+方向键
    Mod+Left hotkey-overlay-title="聚焦左列" { focus-column-or-monitor-left; }
    Mod+Down hotkey-overlay-title="聚焦下方窗口/工作区" { focus-window-or-workspace-down; }
    Mod+Up hotkey-overlay-title="聚焦上方窗口/工作区" { focus-window-or-workspace-up; }
    Mod+Right hotkey-overlay-title="聚焦右列" { focus-column-or-monitor-right; }
    // super+vim key
    Mod+H hotkey-overlay-title="聚焦左列" { focus-column-or-monitor-left; }
    Mod+J hotkey-overlay-title="聚焦下方窗口/工作区" { focus-window-or-workspace-down; }
    Mod+K hotkey-overlay-title="聚焦上方窗口/工作区" { focus-window-or-workspace-up; }
    Mod+L hotkey-overlay-title="聚焦右列" { focus-column-or-monitor-right; }

    // 移动colume（列）
    // super+ctrl+方向键
    Mod+Ctrl+Left hotkey-overlay-title="列左移" { move-column-left; }
    Mod+Ctrl+Right hotkey-overlay-title="列右移" { move-column-right; }
    // super+ctrl+vimkey
    Mod+Ctrl+H hotkey-overlay-title="列左移" { move-column-left; }
    Mod+Ctrl+J hotkey-overlay-title="窗口下移（到底换工作区）" { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+K hotkey-overlay-title="窗口上移（到顶换工作区）" { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+L hotkey-overlay-title="列右移" { move-column-right; }

    // 切换到第一个colume
    Mod+Home hotkey-overlay-title="聚焦第一列" { focus-column-first; }
    // 切换到最后一个colume
    Mod+End hotkey-overlay-title="聚焦最后一列" { focus-column-last; }
    // 移动colume到第一个
    Mod+Ctrl+Home hotkey-overlay-title="列移到最前" { move-column-to-first; }
    // 移动colume到最后一个
    Mod+Ctrl+End hotkey-overlay-title="列移到最后" { move-column-to-last; }

    // 切换显示器聚焦
    // mod+shift+方向键
    Mod+Shift+Left hotkey-overlay-title="聚焦左显示器" { focus-monitor-left; }
    Mod+Shift+Down hotkey-overlay-title="聚焦下显示器" { focus-monitor-down; }
    Mod+Shift+Up hotkey-overlay-title="聚焦上显示器" { focus-monitor-up; }
    Mod+Shift+Right hotkey-overlay-title="聚焦右显示器" { focus-monitor-right; }
    // mod+shift+vimkey
    Mod+Shift+H hotkey-overlay-title="聚焦左显示器" { focus-monitor-left; }
    Mod+Shift+J hotkey-overlay-title="聚焦下显示器" { focus-monitor-down; }
    Mod+Shift+K hotkey-overlay-title="聚焦上显示器" { focus-monitor-up; }
    Mod+Shift+L hotkey-overlay-title="聚焦右显示器" { focus-monitor-right; }
    // 跨显示器移动colume
    Mod+Shift+Ctrl+Left hotkey-overlay-title="列移到左显示器" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down hotkey-overlay-title="列移到下显示器" { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up hotkey-overlay-title="列移到上显示器" { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right hotkey-overlay-title="列移到右显示器" { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H hotkey-overlay-title="列移到左显示器" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J hotkey-overlay-title="列移到下显示器" { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K hotkey-overlay-title="列移到上显示器" { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L hotkey-overlay-title="列移到右显示器" { move-column-to-monitor-right; }

    // 移动整个工作区
    // mod+shift跨显示器，alt代表移动整个工作区，hjkl 与方向键两组

    Mod+Shift+Alt+K hotkey-overlay-title="工作区移到上显示器" { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+J hotkey-overlay-title="工作区移到下显示器" { move-workspace-to-monitor-down; }
    Mod+Shift+Alt+L hotkey-overlay-title="工作区移到右显示器" { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+H hotkey-overlay-title="工作区移到左显示器" { move-workspace-to-monitor-left; }

    Mod+Shift+Alt+Up hotkey-overlay-title="工作区移到上显示器" { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+Down hotkey-overlay-title="工作区移到下显示器" { move-workspace-to-monitor-down; }
    Mod+Shift+Alt+Right hotkey-overlay-title="工作区移到右显示器" { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+Left hotkey-overlay-title="工作区移到左显示器" { move-workspace-to-monitor-left; }

    // mod+shitf+滚轮上下切换工作区
    Mod+Shift+WheelScrollDown hotkey-overlay-title="下一个工作区" cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp hotkey-overlay-title="上一个工作区" cooldown-ms=150 { focus-workspace-up; }
    //再加上ctrl移动窗口
    Mod+Ctrl+Shift+WheelScrollDown hotkey-overlay-title="列移到下个工作区" cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp hotkey-overlay-title="列移到上个工作区" cooldown-ms=150 { move-column-to-workspace-up; }

    // mod+滚轮上下 左右切换聚焦
    Mod+WheelScrollDown hotkey-overlay-title="聚焦右列" { focus-column-right; }
    Mod+WheelScrollUp hotkey-overlay-title="聚焦左列" { focus-column-left; }
    // 再加上ctrl移动colume
    Mod+Ctrl+WheelScrollDown hotkey-overlay-title="列右移" { move-column-right; }
    Mod+Ctrl+WheelScrollUp hotkey-overlay-title="列左移" { move-column-left; }

    // mod+左右方括号 移动窗口（不是移动colume，是允许移动到另一个colume的窗口移动）
    Mod+BracketLeft hotkey-overlay-title="窗口并入左列（或移出）" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="窗口并入右列（或移出）" { consume-or-expel-window-right; }

    // mod+逗号/句号 把窗口合并或者踢出当前的colume
    Mod+Comma hotkey-overlay-title="右侧窗口并入本列" { consume-window-into-column; }
    Mod+Period hotkey-overlay-title="窗口移出本列" { expel-window-from-column; }

    // 开启colume的标签页模式
    Mod+X hotkey-overlay-title="列标签页模式" { toggle-column-tabbed-display; }
    // mod+鼠标侧键 上下切换聚焦
    Mod+MouseForward hotkey-overlay-title="聚焦上方窗口" { focus-window-up; }
    Mod+MouseBack hotkey-overlay-title="聚焦下方窗口" { focus-window-down; }

    // 按照预设切换窗口宽度
    Mod+R hotkey-overlay-title="切换预设宽度" { switch-preset-column-width; }
    // 按照预设切换窗口高度
    Mod+Shift+R hotkey-overlay-title="切换预设高度" { switch-preset-window-height; }
    // 重置窗口高度
    Mod+Ctrl+R hotkey-overlay-title="重置窗口高度" { reset-window-height; }

    Mod+F hotkey-overlay-title="最大化列" { maximize-column; }
    Mod+Alt+F hotkey-overlay-title="全屏" { fullscreen-window; }

    // 增加窗口宽度占满空闲空间
    Mod+Ctrl+F hotkey-overlay-title="列宽占满空位" { expand-column-to-available-width; }
    // 居中当前聚焦的colume
    Mod+O hotkey-overlay-title="居中当前列" { center-column; }
    Mod+Ctrl+O hotkey-overlay-title="居中所有可见列" { center-visible-columns; }

    // mod+加减号调整窗口宽度
    Mod+Minus hotkey-overlay-title="列宽 -5%" { set-column-width "-5%"; }
    Mod+Equal hotkey-overlay-title="列宽 +5%" { set-column-width "+5%"; }

    // mod+shift+加减号调整窗口高度
    Mod+Shift+Minus hotkey-overlay-title="窗口高度 -5%" { set-window-height "-5%"; }
    Mod+Shift+Equal hotkey-overlay-title="窗口高度 +5%" { set-window-height "+5%"; }

    // 切换浮动模式
    Mod+V hotkey-overlay-title="切换浮动" { toggle-window-floating; }
    // 在浮动模式和非浮动模式之间切换聚焦
    Mod+Shift+V hotkey-overlay-title="在浮动/平铺间切换焦点" { switch-focus-between-floating-and-tiling; }

    // 截图相关
    F9 hotkey-overlay-title="截图（选区）" {spawn-sh "niri msg action screenshot --show-pointer false && pkill -f -USR1 screenshot-sound.sh";}
    Ctrl+F9 hotkey-overlay-title="截当前窗口" { spawn-sh "niri msg action screenshot-window --show-pointer false && pkill -f -USR1 screenshot-sound.sh"; }
    Shift+F9 hotkey-overlay-title="截整屏" { spawn-sh "niri msg action screenshot-screen --show-pointer false && pkill -f -USR1 screenshot-sound.sh"; }
    Print hotkey-overlay-title="截图（选区）" {spawn-sh "niri msg action screenshot --show-pointer false && pkill -f -USR1 screenshot-sound.sh";}
    Ctrl+Print hotkey-overlay-title="截当前窗口" { spawn-sh "niri msg action screenshot-window --show-pointer false && pkill -f -USR1 screenshot-sound.sh"; }
    Shift+Print hotkey-overlay-title="截整屏" { spawn-sh "niri msg action screenshot-screen --show-pointer false && pkill -f -USR1 screenshot-sound.sh"; }
    Mod+F9 hotkey-overlay-title="编辑剪贴板图片" { spawn "dank-edit-clipboard-image"; }
    Alt+F9 hotkey-overlay-title="框选取字 OCR" { spawn "dank-ocr"; }

    Mod+Escape hotkey-overlay-title="暂停/恢复 niri 快捷键" allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E hotkey-overlay-title="退出 niri" { quit; }

}
